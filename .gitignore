```gitignore
# Dependencies
node_modules/

# Build artifacts
dist/
build/
*.js.map

# Environment
.env
.env.local
*.env.*

# Editors
.vscode/
.idea/

# Logs
*.log

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Temporary files
*.tmp
*.swp
*~

# OS generated files
.DS_Store
Thumbs.db

# Coverage reports
coverage/
htmlcov/

# MyPy cache
.mypy_cache/

# Pytest cache
.pytest_cache/

# Distribution / packaging
.Python
env/
venv/
.venv/
.ENV
.venv.bak/
venv.bak/

# Compiled and binary files
*.class
*.o
*.so
*.a
*.obj
*.out
*.exe
*.dll
*.dylib
*.jar
*.war
*.zip
*.tar.gz
*.tgz
*.bz2
*.xz
*.7z
*.rar
*.zst
*.lz4
*.lzh
*.cab
*.arj
*.rpm
*.deb
*.Z
*.lz
*.lzo
```
```gitignore
# Dependencies
node_modules/

# Build outputs
dist/
build/
coverage/
htmlcov/

# Environment variables
.env
.env.local
.env.*

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg-info/
.eggs/

# Logs
*.log

# IDE files
.vscode/
.idea/
*.swp
*.swo
*.tmp

# OS generated files
.DS_Store
Thumbs.db

# Testing
.pytest_cache/
.mypy_cache/
.coverage

# Distribution / packaging
*.tar.gz
*.whl
*.egg

# Local configuration
config.json
*.local
```